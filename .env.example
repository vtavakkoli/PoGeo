# Docker Compose model; choose an Ollama model that supports tool calling.
OLLAMA_MODEL=qwen3:4b
RUST_LOG=pogeo=info,tower_http=info

# Direct local execution
DATABASE_URL=postgres://pogeo:pogeo@localhost:5432/pogeo
OLLAMA_URL=http://localhost:11434
POGEO_BIND_ADDRESS=0.0.0.0:8080
POGEO_MAX_FEATURES=500
POGEO_REQUEST_TIMEOUT_SECONDS=120
